{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium",
        "simulator": true,
        "bundleIdentifier": "com.anonymous.app-cuentas-bancarias.dev"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true,
        "buildType": "apk"
      },
      "channel": "development",
      "env": {
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium",
        "bundleIdentifier": "com.anonymous.app-cuentas-bancarias.preview"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "preview",
      "env": {
        "NODE_ENV": "staging"
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m1-medium",
        "bundleIdentifier": "com.anonymous.app-cuentas-bancarias"
      },
      "android": {
        "buildType": "aab"
      },
      "channel": "production",
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "tu-apple-id@ejemplo.com",
        "ascAppId": "1234567890",
        "appleTeamId": "ABCDEFGHIJ"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  },
  "update": {
    "development": {
      "channel": "development"
    },
    "preview": {
      "channel": "preview"
    },
    "production": {
      "channel": "production"
    }
  }
}
