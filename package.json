{
  "name": "app-cuentas-bancarias",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev-server": "npx expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "setup": "node ./scripts/setup-project.js",
    "verify": "node ./scripts/debug-check.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios-simulator": "npx expo run:ios -d \"iPhone 16 Pro Max\"",
    "ios-build": "npx expo export --platform ios --dev false --minify true",
    "web": "expo start --web",
    "build:ios": "expo build:ios --profile development",
    "build:android": "expo build:android --profile development",
    "eas:build:ios": "eas build --platform ios --profile development",
    "eas:build:android": "eas build --platform android --profile development",
    "eas:build:ios:prod": "eas build --platform ios --profile production",
    "eas:build:android:prod": "eas build --platform android --profile production",
    "eas:build:preview": "eas build --platform all --profile preview",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:submit:android": "eas submit --platform android",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules && rm -rf .expo && yarn install",
    "clean:ios": "cd ios && rm -rf build && rm -rf Pods && pod install && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "doctor": "expo doctor",
    "postinstall": "node scripts/patch-undici.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native/normalize-colors": "^0.81.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "expo": "latest",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.8",
    "expo-crypto": "~15.0.7",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linking": "~8.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "jose": "^6.1.0",
    "moment": "^2.30.1",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "recyclerlistview": "^4.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
