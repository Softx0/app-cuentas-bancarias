# API Configuration
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT=10000

# Authentication
EXPO_PUBLIC_JWT_SECRET_KEY=your-secret-key-here
EXPO_PUBLIC_TOKEN_EXPIRATION=3600

# Security
EXPO_PUBLIC_ENCRYPTION_KEY=your-encryption-key-here
EXPO_PUBLIC_APP_SECRET=your-app-secret-here

# App Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_LOG_LEVEL=debug
EXPO_PUBLIC_INACTIVITY_TIMEOUT=900000

# Features
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false
