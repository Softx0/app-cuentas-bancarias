
# INSTRUCCIONES:
# 1. Copia este archivo como .env: cp env.example .env
# 2. Completa todas las variables con tus valores reales
# 3. NUNCA commitees el archivo .env al repositorio
# 4. Variables con EXPO_PUBLIC_ serán incluidas en el bundle
# 5. Variables sin prefijo solo están disponibles en build time
#
# =====================================

# === CONFIGURACIÓN DE AMBIENTE ===
NODE_ENV=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_BUILD_VERSION=1

# === API CONFIGURATION ===
EXPO_PUBLIC_API_URL=https://api-dev.tu-backend.com
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS=3

# === FIREBASE CONFIGURATION ===
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-app-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-app-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-app-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:ios:abcdef1234567890abcdef

# === GOOGLE SERVICES ===
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# === AUTENTICACIÓN Y SEGURIDAD ===
# IMPORTANTE: JWT_SECRET no debe tener EXPO_PUBLIC_ (solo build time)
JWT_SECRET=tu_jwt_secret_super_seguro_minimo_256_bits_aqui
EXPO_PUBLIC_AUTH_DOMAIN=tu-app.firebaseapp.com
EXPO_PUBLIC_AUTH_REDIRECT_URL=com.tucompania.bancapp://auth
EXPO_PUBLIC_ENCRYPTION_KEY=your-encryption-key-here
EXPO_PUBLIC_APP_SECRET=your-app-secret-here

# === SERVICIOS EXTERNOS ===
EXPO_PUBLIC_SENTRY_DSN=https://abcdef@o123456.ingest.sentry.io/123456
EXPO_PUBLIC_MIXPANEL_TOKEN=abcdef1234567890abcdef1234567890

# === NOTIFICACIONES PUSH ===
EXPO_PUBLIC_FCM_SENDER_ID=123456789012
EXPO_PUBLIC_ONESIGNAL_APP_ID=12345678-1234-1234-1234-123456789012
# Server key sin EXPO_PUBLIC_ (solo build time)
FCM_SERVER_KEY=AAAXXXXXXXXX:APA91bXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === SERVICIOS BANCARIOS (SANDBOX) ===
EXPO_PUBLIC_BANK_API_BASE_URL=https://sandbox-api.banco.com
EXPO_PUBLIC_BANK_API_VERSION=v2
# API Keys sin EXPO_PUBLIC_ (solo build time)
BANK_API_KEY=sk_test_1234567890abcdef
BANK_WEBHOOK_SECRET=whsec_1234567890abcdef

# === SERVICIOS DE PAGO ===
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_1234567890abcdef
# Secret key sin EXPO_PUBLIC_ (solo build time)
STRIPE_SECRET_KEY=sk_test_1234567890abcdef

EXPO_PUBLIC_PAYPAL_CLIENT_ID=sb-1234567890abcdef
# Secret key sin EXPO_PUBLIC_ (solo build time)
PAYPAL_CLIENT_SECRET=EOabcdef1234567890

# === VERIFICACIÓN DE IDENTIDAD ===
EXPO_PUBLIC_JUMIO_API_TOKEN=tu_jumio_api_token
EXPO_PUBLIC_JUMIO_API_SECRET=tu_jumio_api_secret

# === CONFIGURACIÓN DE CORREO/SMS ===
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=ACabcdef1234567890abcdef1234567890
# Auth token sin EXPO_PUBLIC_ (solo build time)
TWILIO_AUTH_TOKEN=abcdef1234567890abcdef1234567890ab
EXPO_PUBLIC_TWILIO_PHONE_NUMBER=+1234567890

# === DEEP LINKING ===
EXPO_PUBLIC_APP_SCHEME=com.tucompania.bancapp
EXPO_PUBLIC_WEBSITE_URL=https://www.tu-app.com

# === CONFIGURACIÓN DE DEBUGGING ===
# Solo para development
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug
EXPO_PUBLIC_ENABLE_FLIPPER=true
EXPO_PUBLIC_ENABLE_REACTOTRON=true

# === LEGACY VARIABLES (mantener compatibilidad) ===
EXPO_PUBLIC_JWT_SECRET_KEY=your-secret-key-here
EXPO_PUBLIC_TOKEN_EXPIRATION=3600
EXPO_PUBLIC_INACTIVITY_TIMEOUT=900000

# === FEATURE FLAGS ===
EXPO_PUBLIC_ENABLE_NEW_DASHBOARD=false
EXPO_PUBLIC_ENABLE_BIOMETRIC_LOGIN=true
EXPO_PUBLIC_ENABLE_DARK_THEME=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# === CONFIGURACIÓN DE CACHE ===
EXPO_PUBLIC_CACHE_DURATION=300000
EXPO_PUBLIC_OFFLINE_MODE_ENABLED=true

# === URLS DE TÉRMINOS Y POLÍTICAS ===
EXPO_PUBLIC_TERMS_URL=https://www.tu-app.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://www.tu-app.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://support.tu-app.com

# === CONFIGURACIÓN DE UPDATES ===
EXPO_PUBLIC_UPDATES_ENABLED=true
EXPO_PUBLIC_UPDATES_CHECK_INTERVAL=60000

# =====================================
# NOTAS DE SEGURIDAD
# =====================================
#
# Variables SIN EXPO_PUBLIC_:
# - Solo disponibles en build time
# - Úsalas para: API secrets, DB URLs, server keys
# - Más seguras para información sensible
#
# Variables CON EXPO_PUBLIC_:
# - Incluidas en el bundle de la app
# - Visibles en el código de la app
# - Úsalas para: URLs públicas, IDs públicos, configuraciones
#
# IMPORTANTE:
# - Usa diferentes valores para dev/staging/production
# - Rota las claves regularmente
# - Nunca commitees el archivo .env
# - Usa servicios como Expo Secrets para production
#
# =====================================